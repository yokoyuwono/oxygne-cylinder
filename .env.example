# Salin berkas ini menjadi `.env.local`, lalu isi nilainya.
#
#   cp .env.example .env.local
#
# `.env.local` diabaikan git -- aman untuk kredensial.
# Vite hanya membocorkan variabel berawalan VITE_ ke browser; itu memang
# yang dibutuhkan aplikasi ini, jadi JANGAN taruh service_role key di sini.

# --- Supabase ---
# Dashboard Supabase > Project Settings > API
#
# PENTING: tanpa berkas ini, lib/supabase.ts jatuh ke URL + anon key PRODUKSI
# yang tertulis langsung di kodenya. Artinya `npm run dev` menyentuh data toko
# yang asli. Isi dua baris di bawah dengan project development sendiri sebelum
# mencoba-coba fitur yang menulis data.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Google Gemini (fitur ChatBot) ---
# https://aistudio.google.com/apikey
# vite.config.ts memetakan API_KEY (atau VITE_API_KEY) ke process.env.API_KEY.
# Kosongkan kalau tidak memakai ChatBot; sisa aplikasi tetap jalan.
API_KEY=
